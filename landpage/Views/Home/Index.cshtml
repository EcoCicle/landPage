@model List<WebApplication1.Models.Consumidor>
<h1>Home do projeto</h1>

<form asp-controller="Home" asp-action="BuscarConsumidores" method="get">
    <button type="submit">Buscar Usuários</button>
</form>

<h2>Usuários</h2>

@if (Model != null && Model.Any())
{
    <ul>
        @foreach (var consumidor in Model)
        {
            <li>@consumidor.name</li>
        }
    </ul>

}
else
{
    <p>Nenhum usuário carregado.</p>
}
