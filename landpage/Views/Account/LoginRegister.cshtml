@{
  Layout = "_LoginRegisterLayout";
  ViewData["Title"] = "Registro";
  TempData.Keep();
}

<!-- Botoes toggle de Login e Registro -->
<div class="central-wrapper mx-auto">
  <div class="toggle-container w-100 mb-5 mt-5">
    <button id="btn-login" class="toggle-btn " onclick="toggleLogin(true)">Login</button>
    <button id="btn-registro" class="toggle-btn active" onclick="toggleLogin(false)">Registro</button>

  </div>
</div>
<!-- Formulário de Login -->
<form asp-controller="LoginRegister" asp-action="Login" method="get" id="form-login" class="w-100"
  style="display:block; max-width:25rem; margin-top:1rem;">
  <div class="mb-3">
    <label for="emaillogin" class="form-label mb-3">E-mail</label>
    <input type="email" class="form-control" name="emaillogin" id="email-login" placeholder="Digite seu e-mail"
      required>

  </div>
  <div class="mb-3">
    <label for="password-login" class="form-label mb-3">Senha</label>
    <div class="input-group">
      <input type="password" class="form-control" name="passwordlogin" id="password-login"
        placeholder="Digite sua senha" required>
      <button class="btn btn-outline-secondary" type="button" onclick="toggleSenha('password-login', this)">
        👁️
      </button>
    </div>

  </div>
  <button type="submit" class="btn btn-success mt-3 w-100">Entrar</button>
  @if (TempData["LoginError"] != null)
  {
    <div style="text-align: center; color:red;">
      @TempData["LoginError"]
    </div>
  }
  <div class="d-flex justify-content-between align-items-center mt-2">
    @* <div class="form-check d-flex align-items-center mb-0">
      <input class="form-check-input me-2" type="checkbox" id="lembrar-dados" style="margin-top:0;">
      <label class="form-check-label" for="lembrar-dados" style="margin-bottom:0;">Lembrar dados</label>
    </div> *@
    <a asp-controller="Account" asp-action="EsqueceuSenha" class="btn btn-link p-0">Esqueceu a senha?</a>
  </div>
</form>

<!-- Botões de registro -->
<div id="botoes-registro" style="display:none; max-width:25rem;">
  <div class="d-flex flex-column gap-3 mb-3">
    <button type="button" class="btn btn-outline-success d-flex align-items-start text-start p-3"
      onclick="mostrarFormConsumidor()">
      <span class="me-3" style="font-size:1.5rem;">🛒</span>
      <span>
        <div class="fw-bold text-success">Consumidor</div>
        <div class="small text-muted">Você poderá navegar entre as lojas, favoritar itens ou lojas e ver milhares de
          novidades.</div>
      </span>
    </button>
    <button type="button" class="btn btn-outline-success d-flex align-items-start text-start p-3"
      onclick="mostrarFormVendedor()">
      <span class="me-3" style="font-size:1.5rem;">💰</span>
      <span>
        <div class="fw-bold text-success">Vendedor</div>
        <div class="small text-muted">Você poderá criar sua loja e customizar ela do seu jeitinho, faça ela ter sua
          cara.</div>
      </span>
    </button>
  </div>
</div>

<script>
  // Função para enviar o formulário de registro
  function enviarFormulario() {
    const form = document.getElementById('form-consumidor');
    const formData = new FormData(form);

    fetch('/LoginRegister/CreateUser', { // ajuste para sua rota
      method: 'POST',
      body: formData
    })
      .then(response => response.text())
      .then(data => {
        try {
          // Tenta converter para JSON
          const result = JSON.parse(data);
          const errorDiv = document.getElementById('login-error-message');
          if (result.error === true) {
            // Mostra a mensagem de erro na tela
            if (errorDiv) {
              errorDiv.innerText = result.message || 'Erro ao registrar.';
              errorDiv.style.display = 'block';
            } else {
              // Cria o elemento se não existir
              const div = document.createElement('div');
              div.id = 'login-error-message';
              div.style.textAlign = 'center';
              div.style.color = 'red';
              div.innerText = result.message || 'Erro ao registrar.';
              document.getElementById('form-consumidor').appendChild(div);
            }
          } else {
            // Redireciona para a Home usando função do .NET
            window.location.href = '@Url.Action("Index", "Home")';
          }
        } catch (e) {
          console.error('Erro ao processar resposta:', e);
        }
      })
      .catch(error => {
        console.error('Erro:', error);
      });
  }
</script>
<!-- Formulário de registro como consumidor -->
<form asp-controller="LoginRegister" asp-action="CreateUser" method="post" id="form-consumidor" class="w-100"
  style="display:none; max-width:25rem; margin-top:1rem;">

  <input type="hidden" name="tipo" value="consumidor"> <!-- Identifica o tipo -->
  <div class="mb-3">
    <label for="emailconsumidor" class="form-label">E-mail</label>
    <input type="email" class="form-control" id="emailconsumidor" name="emailconsumidor" placeholder="Digite seu e-mail"
      required>
  </div>

  <div class="mb-3">
    <label for="senhaconsumidor" class="form-label">Senha</label>
    <div class="input-group">
      <input type="password" class="form-control" id="senhaconsumidor" name="senhaconsumidor"
        placeholder="Digite sua senha" required>
      <button class="btn btn-outline-secondary" type="button" onclick="toggleSenha('senhaconsumidor', this)">
        👁️
      </button>
    </div>
  </div>
  <div class="mb-3">
    <label for="confirmarsenhaconsumidor" class="form-label">Confirmar Senha</label>
    <div class="input-group">
      <input type="password" class="form-control" id="confirmarsenhaconsumidor" name="confirmarsenhaconsumidor"
        placeholder="Confirme sua senha" required>
      <button class="btn btn-outline-secondary" type="button" onclick="toggleSenha('confirmarsenhaconsumidor', this)">
        👁️
      </button>
    </div>
  </div>
  <button type="button" onclick="enviarFormulario()" class="btn btn-success w-100">Registrar</button>
  <button type="button" class="btn btn-secondary w-100 mt-2" onclick="voltarParaRegistro()">Voltar</button>
</form>


<!-- Formulário de registro como vendedor -->
<form id="form-vendedor" class="w-100" style="display:none; max-width:25rem; margin-top:1rem;"
  onsubmit="mostrarFormLoja(event)">

  <input type="hidden" name="tipo" value="vendedor"> <!-- Identifica o tipo -->
  <div class="mb-3">
    <label for="email-vendedor" class="form-label">E-mail</label>
    <input type="email" class="form-control" id="email-vendedor" placeholder="Digite seu e-mail" required>
  </div>
  <div class="mb-3">
    <label for="senha-vendedor" class="form-label">Senha</label>
    <div class="input-group">
      <input type="password" class="form-control" id="senha-vendedor" placeholder="Digite sua senha" required>
      <button class="btn btn-outline-secondary" type="button" onclick="toggleSenha('senha-vendedor', this)">
        👁️
      </button>
    </div>
  </div>
  <div class="mb-3">
    <label for="confirmar-senha-vendedor" class="form-label">Confirmar Senha</label>
    <div class="input-group">
      <input type="password" class="form-control" id="confirmar-senha-vendedor" placeholder="Confirme sua senha"
        required>
      <button class="btn btn-outline-secondary" type="button" onclick="toggleSenha('confirmar-senha-vendedor', this)">
        👁️
      </button>
    </div>
  </div>
  <button type="submit" class="btn btn-success w-100">Registrar</button>
  <button type="button" class="btn btn-secondary w-100 mt-2" onclick="voltarParaRegistro()">Voltar</button>
</form>

<!-- Formulário de dados da loja -->
<form id="form-loja" class="w-100" style="display:none; max-width:25rem; margin-top:1rem;">
  <div class="mb-3">
    <label for="nome-loja" class="form-label">Nome da Loja</label>
    <input type="text" class="form-control" id="nome-loja" placeholder="Digite o nome da loja" required>
  </div>
  <div class="mb-3">
    <label for="descricao-loja" class="form-label">Descrição da Loja</label>
    <input type="text" class="form-control" id="descricao-loja" placeholder="Digite uma descrição para a loja" required>
  </div>
  <button type="submit" class="btn btn-success w-100">Finalizar Cadastro</button>
  <button type="button" class="btn btn-secondary w-100 mt-2" onclick="voltarParaFormVendedor()">Voltar</button>
</form>
