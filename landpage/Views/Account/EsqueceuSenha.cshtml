@{
    Layout = "_EsqueceuSenhaLayout";
}

<div class="central-wrapper mx-auto">
    <!-- Formulario Esqueceu sua senha? -->
    <form id="form-es-senha" class="w-100" style="max-width:30rem; margin-top:1rem;">
        <h2 class="mb-5 text-start w-100 central-wrapper mx-auto">
        Esqueceu <br>
        sua Senha?
        </h2>
        <div class="mb-5">
            <p class="fs-4">
                Informe seu email cadastrado para que seja enviado o código de verificação
            </p>
        </div>
        <div class="mb-4">
            <label for="email-es-senha" class="form-label">E-mail</label>
            <input type="email" class="form-control" id="email-es-senha" placeholder="Digite seu e-mail" required>
        </div>
        <div>
            <button type="submit" class="btn btn-success w-100">Enviar código</button>
            <a href="/Account/LoginRegister" class="btn btn-secondary w-100 mt-2">Voltar</a>
        </div>
    </form>
    <!-- Formulario Codigo email -->
    <form style="display:none; max-width:30rem; margin-top:1rem;" id="form-codigo-email">
        <h2 class="mb5 text-start w-100 central-wrapper mx-auto">
            Verificando <br>
            autenticidade
        </h2>
        <h5 class="fs-4">
            Informe o código
        </h5>
        <p class="fs-5 mb-4">
            Informe o código que foi enviado para o seu e-mail. <br>
        </p>
        <label for="codigo" class="form-label">Código</label>
        <div class="d-flex gap-2 w-100">
            <input type="text" class="form-control text-center code-input" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code">
            <input type="text" class="form-control text-center code-input" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code">
            <input type="text" class="form-control text-center code-input" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code">
            <input type="text" class="form-control text-center code-input" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code">
            <input type="text" class="form-control text-center code-input" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code">
            <input type="text" class="form-control text-center code-input" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code">
        </div>
        <div>
            <button type="submit" class="btn btn-success w-100 mt-3">Confirmar código</button>
            <a href="#" class="btn btn-secondary w-100 mt-2" onclick="voltarParaEmail(event)">Voltar</a> 
        </div>
    </form>
    <!-- Formulario mudar senha? -->
    <form id="mudar-senha" class="w-100" style="display:none; max-width:30rem; margin-top:1rem;">
        <h2>
            Nova <br>
            Senha
        </h2>
        <div class="mb-5">
            <p class="fs-4">
                Informe sua Nova senha
            </p>
        </div>
        <div class="mb-4 position-relative">
            <label for="nova-senha" class="form-label">Nova senha</label>
            <input type="password" class="form-control" id="nova-senha" placeholder="Digite sua nova senha" required>
            <button type="button" class="btn btn-outline-secondary btn-sm position-absolute top-50 end-0 translate-middle-y me-2" 
                onclick="toggleSenha('nova-senha', this)" tabindex="-1">
                👁️
            </button>
        </div>
        <div class="mb-4 position-relative">
            <label for="confirma-senha" class="form-label">Confirme a senha</label>
            <input type="password" class="form-control" id="confirma-senha" placeholder="Confirme sua nova senha" required>
            <button type="button" class="btn btn-outline-secondary btn-sm position-absolute top-50 end-0 translate-middle-y me-2" 
                onclick="toggleSenha('confirma-senha', this)" tabindex="-1">
                👁️
            </button>
        </div>
        <div>
            <button type="submit" class="btn btn-success w-100">Salvar nova senha</button>
            <a href="#" class="btn btn-secondary w-100 mt-2" onclick="voltarParaCodigo(event)">Voltar</a> 
        </div>
    </form>
</div>

<script>
function voltarParaEmail(e) {
    e.preventDefault();
    document.getElementById('form-codigo-email').style.display = 'none';
    document.getElementById('form-es-senha').style.display = 'block';
}
function voltarParaCodigo(e) {
    e.preventDefault();
    document.getElementById('mudar-senha').style.display = 'none';
    document.getElementById('form-codigo-email').style.display = 'block';
}
function toggleSenha(id, btn) {
    const input = document.getElementById(id);
    if (input.type === "password") {
        input.type = "text";
        btn.innerText = "🙈";
    } else {
        input.type = "password";
        btn.innerText = "👁️";
    }
}
</script>