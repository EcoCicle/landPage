@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] Esqueceu sua Senha? - EcoCicle</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/home/index.css" rel="stylesheet" asp-append-version="true" />
</head>

<body>
    <div class="custom-flex-container">

        <div class="custom-col-left d-flex flex-column justify-content-center align-items-center">
            <h2 class="mb-5 text-start w-100 central-wrapper mx-auto">Esqueceu sua Senha?</h2>
            <div class="central-wrapper mx-auto">
                <!-- Formulario Esqueceu sua senha? -->
                <form id="form-es.senha" class="w-100" style="max-width:30rem; margin-top:1rem;">
                    <div class="mb-5">
                        <p class="fs-4">
                            Informe seu email cadastrado para que seja enviado o código de verificação
                        </p>
                    </div>
                    <div class="mb-4">
                        <label for="email-es.senha" class="form-label">E-mail</label>
                        <input type="email" class="form-control" id="email-es.senha" placeholder="Digite seu e-mail" required>
                    </div>
                    <div>
                        <button type="submit" class="btn btn-success w-100">Enviar código</button>
                        <a href="/Account/LoginRegister" class="btn btn-secondary w-100 mt-2">Voltar</a>
                    </div>
                </form>
            </div>
            <footer class="w-100 text-center mt-auto mb-4">
                <small>Todos os direitos reservados à EcoClice</small>
            </footer>
        </div>
        <div class="custom-col-right py-4 px-5" style="overflow:hidden;">
            <img src="~/img/imagemmetver.png" class="img-fluid rounded-3 shadow"
                style="width:100%; height:90vh; object-fit:cover; display:block;" alt="Imagem" />
        </div>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/esqueceusenha.js"></script>
</body>

</html>


