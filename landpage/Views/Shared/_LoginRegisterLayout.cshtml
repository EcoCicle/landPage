<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EcoCicle</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="~/css/home/index.css" rel="stylesheet" asp-append-version="true" />
</head>

<body>
    <div class="custom-flex-container">
        
        <div class="custom-col-left d-flex flex-column justify-content-center align-items-center">
            <h2 class="mb-5 text-start w-100">Seja Bem Vindo!</h2>
            <div class="central-wrapper mx-auto">
                <div class="toggle-container w-100 mb-5 mt-5">
                    <button id="btn-login" class="toggle-btn" onclick="toggleLogin(true)">Login</button>
                    <button id="btn-registro" class="toggle-btn active" onclick="toggleLogin(false)">Registro</button>
                </div>
                @RenderBody()
            </div>
            <footer class="w-100 text-center mt-auto mb-4">
                <small>Todos os direitos reservados à EcoClice</small>
            </footer>
        </div>
        <div class="custom-col-right py-4 px-5" style="overflow:hidden;">
          <img src="~/img/imagemmetver.png"
            class="img-fluid rounded-3 shadow"
               style="width:100%; height:100%; object-fit:cover; display:block;" alt="Imagem" />
        </div>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/register.js"></script>
</body>
</html>
